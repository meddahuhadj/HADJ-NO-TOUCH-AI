{
  "name": "HADJ NO-TOUCH OFFLINE AI",
  "short_name": "HADJ",
  "description": "Complete touchless computer control: voice, hand gestures, screen vision and offline AI. 100% on-device, zero cloud calls.",
  "id": "./",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#060A12",
  "theme_color": "#060A12",
  "lang": "ar",
  "dir": "auto",
  "categories": ["utilities", "productivity", "accessibility"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/favicon-64.png", "sizes": "64x64", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Run the tests",
      "short_name": "Tests",
      "url": "./#run"
    },
    {
      "name": "Gesture reference",
      "short_name": "Gestures",
      "url": "./#gestures"
    }
  ]
}
